---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { formatDate } from '@/lib/format';
import { site } from '@/site';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---
<BaseLayout title="Writing" description="Essays and lessons on B2B SaaS growth from Gregory Schnese: yield-based bidding, segment analysis and A/B testing.">
  <PageHeader eyebrow="Writing" title="Notes on growth, measurement and building." lede="Practical lessons from running paid acquisition and growth teams.">
    <p class="mt-6 text-sm text-muted dark:text-night-muted">
      For weekly writing, subscribe to <a href={site.newsletter.url} class="link-accent" target="_blank" rel="noopener">{site.newsletter.name}</a> · <a href="/rss.xml" class="link-accent">RSS</a>
    </p>
  </PageHeader>
  <section class="container-page">
    <ol class="divide-y divide-line border-y border-line dark:divide-night-line dark:border-night-line">
      {posts.map((p) => (
        <li data-reveal>
          <a href={`/writing/${p.id}`} class="group grid gap-2 py-8 sm:grid-cols-[10rem_1fr] sm:gap-10">
            <p class="eyebrow pt-1.5"><time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate, 'short')}</time></p>
            <div>
              {p.data.series && <p class="text-sm text-accent dark:text-night-accent">{p.data.series}{p.data.seriesPart && ` · Lesson ${p.data.seriesPart}`}</p>}
              <h2 class="mt-1 text-2xl font-semibold tracking-tight text-balance group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">{p.data.title}</h2>
              <p class="mt-2 max-w-2xl text-pretty text-muted dark:text-night-muted">{p.data.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
