---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProofBar from '@/components/ProofBar.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import ProjectTile from '@/components/ProjectTile.astro';
import CtaBand from '@/components/CtaBand.astro';
import { primaryCta, principles, site, testimonials } from '@/site';
import { profilePage } from '@/lib/schema';
import { formatDate } from '@/lib/format';
import profile from '@/assets/profile.jpg';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const [now] = (await getCollection('now')).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
const logos = ['FMX', 'Fleetio', 'CoPromote', 'kikin'];
---
<BaseLayout jsonLd={profilePage('/')} ogType="profile">
  <!-- Hero -->
  <section class="container-page grid items-center gap-12 pt-16 pb-16 sm:pt-24 lg:grid-cols-[1fr_auto] lg:pb-24">
    <div>
      <p class="eyebrow mb-6 flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-accent dark:bg-night-accent" aria-hidden="true"></span>
        {site.jobTitle} at {site.employer.name}
      </p>
      <h1 class="max-w-4xl text-[2.6rem] leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl lg:text-7xl">
        I build B2B SaaS demand engines<span class="text-muted dark:text-night-muted"> and the software behind them.</span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg text-pretty text-muted sm:text-xl dark:text-night-muted">
        I’m Gregory Schnese, a demand generation leader with 15+ years in B2B SaaS growth. I lead demand gen at FMX; before that I scaled Fleetio’s inbound ARR 10x. On the side, I ship apps with AI agents.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href={primaryCta.href}
          class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-px dark:bg-night-accent dark:text-night"
          data-event="cta_click"
        >{primaryCta.label}</a>
        <a href="/work" class="rounded-full px-6 py-3 text-sm font-medium ring-1 ring-line transition-colors hover:ring-ink dark:ring-night-line dark:hover:ring-night-ink">Read the case studies</a>
      </div>
    </div>
    <div class="relative mx-auto w-48 sm:w-60 lg:w-72">
      <div class="absolute -inset-3 -z-10 rotate-3 rounded-[2rem] bg-accent-soft dark:bg-night-accent-soft" aria-hidden="true"></div>
      <Image
        src={profile}
        alt="Portrait of Gregory Schnese"
        widths={[240, 360, 480, 600]}
        sizes="(min-width: 1024px) 288px, (min-width: 640px) 240px, 192px"
        class="aspect-square w-full rounded-[1.75rem] object-cover grayscale-[15%]"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <ProofBar />

  <!-- Selected work -->
  <section class="container-page mt-24 sm:mt-32">
    <SectionHeading eyebrow="Selected work" title="Growth systems, measured in revenue." href="/work" linkLabel="All case studies" />
    <div class="grid gap-5 md:grid-cols-3">
      {work.map((entry) => <CaseStudyCard entry={entry} />)}
    </div>
  </section>

  <!-- Things I build -->
  <section class="container-page mt-24 sm:mt-32">
    <SectionHeading eyebrow="Things I build" title="I don’t just brief engineers. I ship." href="/projects" linkLabel="All projects" />
    <div class="grid gap-5 md:grid-cols-6 md:grid-rows-[auto_auto]">
      {projects[0] && <ProjectTile entry={projects[0]} large class="md:col-span-4 md:row-span-2 md:min-h-[26rem]" />}
      {projects[1] && <ProjectTile entry={projects[1]} class="md:col-span-2" />}
      {projects[2] && <ProjectTile entry={projects[2]} class="md:col-span-2" />}
      <a
        href={site.repoUrl}
        target="_blank"
        rel="noopener"
        class="group flex flex-col justify-between gap-6 rounded-2xl border border-dashed border-line p-7 transition-colors hover:border-ink md:col-span-6 md:flex-row md:items-center dark:border-night-line dark:hover:border-night-ink"
        data-reveal
      >
        <p class="font-mono text-sm text-muted dark:text-night-muted">
          <span class="text-ink dark:text-night-ink">$</span> This site is built with Astro, Tailwind and AI coding agents, and the source is public.
        </p>
        <span class="text-sm font-medium whitespace-nowrap">View source <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">↗</span></span>
      </a>
    </div>
  </section>

  <!-- Point of view -->
  <section class="container-page mt-24 sm:mt-32">
    <SectionHeading eyebrow="How I work" title="Three principles I bring to every growth team." />
    <ol class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-3 dark:border-night-line dark:bg-night-line">
      {principles.map((p, i) => (
        <li class="bg-paper p-7 dark:bg-night" data-reveal>
          <p class="tabular font-mono text-sm text-accent dark:text-night-accent">0{i + 1}</p>
          <h3 class="mt-4 text-xl font-semibold tracking-tight">{p.title}</h3>
          <p class="mt-3 text-pretty text-muted dark:text-night-muted">{p.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Social proof -->
  <section class="container-page mt-24 sm:mt-32" aria-labelledby="proof-heading">
    <h2 id="proof-heading" class="eyebrow text-center">Where I’ve done it</h2>
    <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-12 gap-y-4 text-2xl font-semibold tracking-tight text-muted/80 sm:text-3xl dark:text-night-muted">
      {logos.map((l) => <li>{l}</li>)}
    </ul>
    {testimonials.length > 0 && (
      <div class="mt-14 grid gap-5 md:grid-cols-2">
        {testimonials.map((t) => (
          <figure class="card p-8" data-reveal>
            <blockquote class="font-serif text-xl leading-relaxed text-pretty">“{t.quote}”</blockquote>
            <figcaption class="mt-6 text-sm"><span class="font-semibold">{t.name}</span><span class="text-muted dark:text-night-muted"> · {t.title}</span></figcaption>
          </figure>
        ))}
      </div>
    )}
  </section>

  <!-- Writing + newsletter -->
  <section class="container-page mt-24 grid gap-5 sm:mt-32 lg:grid-cols-[1.3fr_1fr]">
    <div class="card p-7 sm:p-9" data-reveal>
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="eyebrow">Writing</h2>
        <a href="/writing" class="link-accent text-sm">All writing →</a>
      </div>
      <ul class="mt-6 divide-y divide-line dark:divide-night-line">
        {posts.map((p) => (
          <li>
            <a href={`/writing/${p.id}`} class="group block py-5">
              <p class="font-semibold tracking-tight group-hover:text-accent dark:group-hover:text-night-accent">{p.data.title}</p>
              <p class="mt-1 text-sm text-muted dark:text-night-muted">{p.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="flex flex-col rounded-2xl bg-accent-soft p-7 sm:p-9 dark:bg-night-accent-soft" data-reveal>
      <h2 class="eyebrow">Newsletter · {site.newsletter.cadence}</h2>
      <p class="mt-5 text-2xl font-semibold tracking-tight">{site.newsletter.name}</p>
      <p class="mt-3 flex-1 text-pretty text-muted dark:text-night-muted">{site.newsletter.blurb}</p>
      <a
        href={site.newsletter.url}
        target="_blank"
        rel="noopener"
        class="mt-6 self-start rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition-transform hover:-translate-y-px dark:bg-night-ink dark:text-night"
        data-event="newsletter_click"
      >Subscribe free ↗</a>
    </div>
  </section>

  <!-- Now -->
  {now && (
    <section class="container-page mt-16" data-reveal>
      <a href="/now" class="group flex flex-col gap-2 border-l-2 border-accent py-1 pl-5 sm:flex-row sm:items-baseline sm:gap-6 dark:border-night-accent">
        <span class="eyebrow shrink-0">Now · {formatDate(now.data.updated, 'short')}</span>
        <span class="text-pretty">{now.data.summary} <span class="text-accent dark:text-night-accent" aria-hidden="true">→</span></span>
      </a>
    </section>
  )}

  <CtaBand />
</BaseLayout>
