---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/site';

interface Props {
  title?: string;
  description?: string;
  /** Path to an OG image, defaults to the generated one for this page */
  ogImage?: string;
  /** Alt text for the share image; defaults to the page title */
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  /** Attach the intro video as og:video (home and about) */
  ogVideo?: boolean;
  /** article:section / article:tag for essays */
  articleTag?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  ogVideo = false,
  articleTag,
  jsonLd,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogPath =
  Astro.props.ogImage ??
  `/og/${Astro.url.pathname.replace(/^\/|\/$/g, '') || 'index'}.png`;
const ogImage = new URL(ogPath, site.url).href;
const ogTitle = title ?? site.title;
const ogImageAlt =
  Astro.props.ogImageAlt ??
  (title
    ? `${title} — ${site.name}`
    : `${site.name}: “I build B2B SaaS demand engines and the software behind them.” Headshot with 10x, 2x, $4M+ and 700K+ results.`);
const video = {
  url: new URL(site.introVideo.mp4, site.url).href,
  width: site.introVideo.width,
  height: site.introVideo.height,
};
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={site.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e0c" media="(prefers-color-scheme: dark)" />
    {site.social.map((s) => <link rel="me" href={s.url} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogVideo && (
      <>
        <meta property="og:video" content={video.url} />
        <meta property="og:video:secure_url" content={video.url} />
        <meta property="og:video:type" content="video/mp4" />
        <meta property="og:video:width" content={String(video.width)} />
        <meta property="og:video:height" content={String(video.height)} />
      </>
    )}
    {ogType === 'profile' && (
      <>
        <meta property="profile:first_name" content="Gregory" />
        <meta property="profile:last_name" content="Schnese" />
        <meta property="profile:username" content="theschnaz" />
      </>
    )}
    {ogType === 'article' && (
      <>
        <meta property="article:author" content={new URL('/about', site.url).href} />
        {articleTag && <meta property="article:section" content={articleTag} />}
        {articleTag && <meta property="article:tag" content={articleTag} />}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@theschnaz" />
    <meta name="twitter:creator" content="@theschnaz" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {ld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <script is:inline>
      document.documentElement.classList.add('js');
      const t = localStorage.getItem('theme');
      if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
    {site.gaMeasurementId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaId: site.gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll-in reveal + proof-bar count-up. Skipped entirely under reduced motion.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const countUp = (el: HTMLElement) => {
        const target = Number(el.dataset.count);
        if (reduce || !target) return;
        const start = performance.now();
        const dur = 900;
        const tick = (now: number) => {
          const p = Math.min((now - start) / dur, 1);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target as HTMLElement;
              el.classList.add('is-visible');
              el.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
              io.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      }

      // Google Analytics custom events: <a data-event="event_name">
      document.addEventListener('click', (ev) => {
        const a = (ev.target as Element).closest<HTMLElement>('[data-event]');
        const w = window as unknown as { gtag?: (...args: unknown[]) => void };
        if (a && w.gtag) {
          w.gtag('event', a.dataset.event!, {
            page_path: location.pathname,
            link_url: a.getAttribute('href') ?? undefined,
          });
        }
      });
    </script>
  </body>
</html>
