---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { tools } from '@/lib/mcp';
import { site } from '@/site';

const u = (p: string) => new URL(p, site.url).href;
const mcpTools = await tools();
const claudeCode = `claude mcp add --transport http gregory-schnese ${u('/mcp')}`;
const jsonConfig = JSON.stringify({ mcpServers: { 'gregory-schnese': { type: 'http', url: u('/mcp') } } }, null, 2);
const endpoints = [
  { name: 'Markdown pages', href: '/index.md', desc: 'Add .md to any page URL for clean Markdown, e.g. /work/fleetio.md.' },
  { name: 'llms.txt', href: '/llms.txt', desc: 'Index of every page, in the llmstxt.org format.' },
  { name: 'llms-full.txt', href: '/llms-full.txt', desc: 'All site content in one Markdown file.' },
  { name: 'MCP server', href: '/mcp', desc: 'Streamable HTTP, read-only, no auth. Manifest at /.well-known/mcp.json.' },
  { name: 'JSON Resume', href: '/resume.json', desc: 'Machine-readable resume in the jsonresume.org schema.' },
  { name: 'Facts', href: '/facts', desc: 'Short Q&A answers, with FAQPage structured data.' },
];
---
<BaseLayout title="For AI agents" description={`Machine-readable ways for AI agents to learn about ${site.name}: Markdown pages, llms.txt, an MCP server and a JSON Resume.`}>
  <PageHeader eyebrow="For AI agents" title="Built to be read by agents, too." lede={`Every page here has a clean, machine-readable version, and there’s an MCP server so your assistant can look up ${site.name} directly.`} />
  <section class="container-page grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {endpoints.map((e) => (
      <a href={e.href} class="card group flex flex-col p-6 transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-ink/5">
        <span class="font-mono text-sm text-accent dark:text-night-accent">{e.href}</span>
        <span class="mt-3 font-semibold tracking-tight">{e.name}</span>
        <span class="mt-1 text-sm text-pretty text-muted dark:text-night-muted">{e.desc}</span>
      </a>
    ))}
  </section>

  <section class="container-page mt-16 grid gap-10 lg:grid-cols-[1fr_1fr]">
    <div>
      <h2 class="text-2xl font-semibold tracking-tight">Connect the MCP server</h2>
      <p class="mt-3 text-pretty text-muted dark:text-night-muted">Add it to Claude Code:</p>
      <pre class="mt-3 overflow-x-auto rounded-xl bg-ink p-4 font-mono text-sm text-paper dark:bg-night-card dark:ring-1 dark:ring-night-line"><code>{claudeCode}</code></pre>
      <p class="mt-5 text-pretty text-muted dark:text-night-muted">Or in any client that takes an <code class="font-mono text-sm">mcpServers</code> config, such as Cursor:</p>
      <pre class="mt-3 overflow-x-auto rounded-xl bg-ink p-4 font-mono text-sm text-paper dark:bg-night-card dark:ring-1 dark:ring-night-line"><code>{jsonConfig}</code></pre>
      <p class="mt-5 text-pretty text-muted dark:text-night-muted">In Claude or ChatGPT, add <span class="font-mono text-sm">{u('/mcp')}</span> as a custom connector.</p>
    </div>
    <div>
      <h2 class="text-2xl font-semibold tracking-tight">Tools</h2>
      <ul class="mt-4 divide-y divide-line border-y border-line dark:divide-night-line dark:border-night-line">
        {mcpTools.map((t) => (
          <li class="py-3">
            <code class="font-mono text-sm font-medium">{t.name}</code>
            <p class="mt-1 text-sm text-pretty text-muted dark:text-night-muted">{t.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
