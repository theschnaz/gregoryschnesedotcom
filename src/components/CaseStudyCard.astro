---
import type { CollectionEntry } from 'astro:content';
interface Props {
  entry: CollectionEntry<'work'>;
}
const { entry } = Astro.props;
const d = entry.data;
---
<a
  href={`/work/${entry.id}`}
  class="card group flex h-full flex-col p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-ink/5 dark:hover:shadow-black/40"
  data-reveal
>
  <p class="eyebrow">{d.company} · {d.period}</p>
  <p class="tabular mt-6 text-6xl font-semibold tracking-tighter text-accent dark:text-night-accent">{d.metric}</p>
  <p class="mt-1 font-medium">{d.metricLabel}</p>
  <p class="mt-4 flex-1 text-pretty text-muted dark:text-night-muted">{d.summary}</p>
  <span class="mt-6 text-sm font-medium">
    Read the case study <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span>
  </span>
</a>
