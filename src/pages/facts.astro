---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import AskAI from '@/components/AskAI.astro';
import { facts, factsUpdated } from '@/data/facts';
import { inlineMd, stripInlineMd } from '@/lib/inline-md';
import { faqPage } from '@/lib/schema';
import { site } from '@/site';

const slug = (q: string) => q.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const updated = new Date(`${factsUpdated}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout
  title="At a glance"
  description={`Short answers about ${site.name}: current role, results at Fleetio and CoPromote, teams led, software built, education and contact.`}
  jsonLd={faqPage(facts.map((f) => ({ q: f.q, a: stripInlineMd(f.a) })))}
>
  <PageHeader eyebrow="At a glance" title={`${site.name}, in short answers.`} lede="The questions people most often ask about me, answered in a sentence or two, with links to the full story.">
    <p class="mt-6 text-sm text-muted dark:text-night-muted">Last updated <time datetime={factsUpdated}>{updated}</time></p>
  </PageHeader>
  <section class="container-page">
    <div class="grid gap-10 lg:grid-cols-[16rem_1fr]">
      <nav aria-label="Questions" class="hidden lg:block">
        <ol class="sticky top-24 space-y-2 text-sm">
          {facts.map((f) => (
            <li><a href={`#${slug(f.q)}`} class="text-muted hover:text-ink dark:text-night-muted dark:hover:text-night-ink">{f.q}</a></li>
          ))}
        </ol>
      </nav>
      <div>
        <dl class="divide-y divide-line border-y border-line dark:divide-night-line dark:border-night-line">
          {facts.map((f, i) => (
            <div id={slug(f.q)} class="scroll-mt-24 py-8 sm:pl-12">
              <dt class="relative text-xl font-semibold tracking-tight">
                <span class="tabular font-mono text-sm font-normal text-accent sm:absolute sm:top-1.5 sm:-left-12 dark:text-night-accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="block sm:inline">{f.q}</span>
              </dt>
              <dd class="mt-3 max-w-2xl font-serif text-lg leading-relaxed text-pretty text-muted dark:text-night-muted" set:html={inlineMd(f.a)} />
            </div>
          ))}
        </dl>
        <AskAI class="mt-10" />
      </div>
    </div>
  </section>
</BaseLayout>
