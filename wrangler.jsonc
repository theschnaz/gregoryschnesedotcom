// Cloudflare Workers + static assets. Deploy with `npm run deploy`
// (or connect the repo in the Cloudflare dashboard with build command
// `npm run build` and deploy command `npx wrangler deploy`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gregoryschnese-com",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
