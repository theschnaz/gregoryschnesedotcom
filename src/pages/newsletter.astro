---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/site';
---
<BaseLayout title="Newsletter" description={`${site.newsletter.name}: ${site.newsletter.blurb}`}>
  <PageHeader eyebrow={`Newsletter · ${site.newsletter.cadence}`} title={site.newsletter.name} lede={site.newsletter.blurb}>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href={site.newsletter.url} target="_blank" rel="noopener" class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-px dark:bg-night-accent dark:text-night" data-event="newsletter_click">Subscribe free ↗</a>
    </div>
  </PageHeader>
  <section class="container-page">
    <div class="grid gap-5 md:grid-cols-3">
      <div class="card p-7"><p class="eyebrow">Who it’s for</p><p class="mt-3 text-pretty">Long-term Bitcoin holders who want to fund their life without selling, and want the math done honestly.</p></div>
      <div class="card p-7"><p class="eyebrow">What you get</p><p class="mt-3 text-pretty">One email a week: scenarios from the model, loan-to-value risk, lending market notes and reader questions.</p></div>
      <div class="card p-7"><p class="eyebrow">What it isn’t</p><p class="mt-3 text-pretty">Financial advice, price predictions or hype. Just modeling and tradeoffs.</p></div>
    </div>
    <p class="mt-10 max-w-2xl text-sm text-pretty text-muted dark:text-night-muted">
      Looking for growth and demand-gen writing instead? That lives on the <a href="/writing" class="link-accent">writing page</a>.
    </p>
  </section>
</BaseLayout>
