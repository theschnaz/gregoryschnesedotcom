---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Not found" noindex>
  <section class="container-page py-32 text-center">
    <p class="tabular font-mono text-sm text-accent dark:text-night-accent">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">This page didn’t convert.</h1>
    <p class="mt-4 text-muted dark:text-night-muted">The link may be old, or the page moved.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper dark:bg-night-ink dark:text-night">Home</a>
      <a href="/writing" class="rounded-full px-5 py-2.5 text-sm font-medium ring-1 ring-line dark:ring-night-line">Writing</a>
    </div>
  </section>
</BaseLayout>
