---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/site';

const linkedin = site.social.find((s) => s.name === 'LinkedIn')!;
const others = site.social.filter((s) => s.name !== 'LinkedIn');
---
<BaseLayout title="Contact" description="Reach Gregory Schnese by email or LinkedIn about demand generation, advisory work or anything on this site.">
  <PageHeader
    eyebrow="Contact"
    title="The best way to reach me."
    lede="Recruiter, founder, fellow growth person or reader: email or LinkedIn both get to me directly. I usually reply within a few days."
  />
  <section class="container-page grid gap-5 md:grid-cols-2">
    <div class="card flex flex-col p-8 sm:p-10" data-reveal>
      <div class="flex items-center gap-3">
        <span class="grid size-11 place-items-center rounded-full bg-accent-soft text-accent dark:bg-night-accent-soft dark:text-night-accent" aria-hidden="true">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
        </span>
        <h2 class="eyebrow">Email</h2>
      </div>
      <p class="mt-8 text-2xl font-semibold tracking-tight break-all sm:text-3xl">{site.email}</p>
      <p class="mt-3 flex-1 text-pretty text-muted dark:text-night-muted">Best for advisory inquiries, roles and anything that needs more than a few lines.</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${site.email}`}
          class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-px dark:bg-night-accent dark:text-night"
          data-event="email_click"
        >Send an email</a>
        <button
          type="button"
          id="copy-email"
          data-email={site.email}
          class="rounded-full px-5 py-3 text-sm font-medium ring-1 ring-line transition-colors hover:ring-ink dark:ring-night-line dark:hover:ring-night-ink"
        >Copy address</button>
        <span id="copy-status" class="text-sm text-muted dark:text-night-muted" role="status" aria-live="polite"></span>
      </div>
    </div>

    <div class="card flex flex-col p-8 sm:p-10" data-reveal>
      <div class="flex items-center gap-3">
        <span class="grid size-11 place-items-center rounded-full bg-accent-soft text-accent dark:bg-night-accent-soft dark:text-night-accent" aria-hidden="true">
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" /></svg>
        </span>
        <h2 class="eyebrow">LinkedIn</h2>
      </div>
      <p class="mt-8 text-2xl font-semibold tracking-tight sm:text-3xl">Gregory Schnese</p>
      <p class="mt-3 flex-1 text-pretty text-muted dark:text-night-muted">Connect or send a message. Mention this site so I know where you found me.</p>
      <div class="mt-8">
        <a
          href={linkedin.url}
          target="_blank"
          rel="me noopener"
          class="inline-block rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper transition-transform hover:-translate-y-px dark:bg-night-ink dark:text-night"
          data-event="linkedin_click"
        >Message me on LinkedIn ↗</a>
      </div>
    </div>
  </section>
  <section class="container-page mt-12">
    <p class="text-sm text-muted dark:text-night-muted">
      Also on{' '}
      {others.map((s, i) => (
        <>{i > 0 && ' and '}<a href={s.url} target="_blank" rel="me noopener" class="link-accent">{s.name}</a></>
      ))}.
    </p>
  </section>
  <script>
    const btn = document.getElementById('copy-email') as HTMLButtonElement;
    const status = document.getElementById('copy-status')!;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.email!);
        status.textContent = 'Copied';
      } catch {
        status.textContent = 'Press Ctrl/Cmd+C to copy';
      }
      setTimeout(() => (status.textContent = ''), 2500);
    });
  </script>
</BaseLayout>
