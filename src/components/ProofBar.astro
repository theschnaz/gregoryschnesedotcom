---
import { proof } from '@/site';
---
<section aria-label="Results at a glance" class="container-page" data-reveal>
  <dl class="grid grid-cols-2 border-y border-line lg:grid-cols-4 dark:border-night-line">
    {proof.map((p, i) => (
      <div class:list={[
        'py-8 sm:py-10',
        i % 2 === 1 && 'border-l border-line pl-5 sm:pl-8 dark:border-night-line',
        i >= 2 && 'border-t border-line lg:border-t-0 dark:border-night-line',
        i === 2 && 'lg:border-l lg:pl-8',
        i > 0 && 'lg:pl-8',
      ]}>
        <dt class="sr-only">{p.label} ({p.context})</dt>
        <dd>
          <p class="tabular text-5xl font-semibold tracking-tighter sm:text-6xl" aria-hidden="true">
            {'prefix' in p ? p.prefix : ''}<span data-count={p.value}>{p.value}</span><span class="text-accent dark:text-night-accent">{p.suffix}</span>
          </p>
          <span class="sr-only">{'prefix' in p ? p.prefix : ''}{p.value}{p.suffix}</span>
          <p class="mt-2 text-sm font-medium" aria-hidden="true">{p.label}</p>
          <p class="eyebrow mt-1" aria-hidden="true">{p.context}</p>
        </dd>
      </div>
    ))}
  </dl>
</section>
