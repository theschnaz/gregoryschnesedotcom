---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AskAI from '@/components/AskAI.astro';
import CtaBand from '@/components/CtaBand.astro';
import { education, experience } from '@/data/resume';
import { profilePage } from '@/lib/schema';
import { site } from '@/site';
import profile from '@/assets/profile.jpg';

const { Content: Bio } = await render((await getEntry('pages', 'about'))!);
---
<BaseLayout title="About" description={site.description} jsonLd={profilePage("/about")} ogType="profile" ogVideo>
  <section class="container-page grid gap-12 pt-16 sm:pt-24 lg:grid-cols-[1fr_20rem] lg:gap-20">
    <div>
      <p class="eyebrow">About</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-balance sm:text-6xl">A growth marketer who writes the code.</h1>
      <div class="prose-gs mt-10 max-w-2xl">
        <Bio />
      </div>
      <AskAI class="mt-10 max-w-2xl" />
    </div>
    <aside class="lg:pt-10">
      <Image src={profile} alt="Portrait of Gregory Schnese" widths={[320, 480, 600]} sizes="(min-width: 1024px) 320px, 100vw" class="aspect-square w-full max-w-80 rounded-3xl object-cover" />
      <dl class="mt-8 space-y-5 text-sm">
        <div>
          <dt class="eyebrow">Now</dt>
          <dd class="mt-1">{site.jobTitle}, {site.employer.name}</dd>
        </div>
        <div>
          <dt class="eyebrow">Previously</dt>
          <dd class="mt-1">{experience.slice(1).map((e) => e.company.replace(' Inc.', '')).join(' · ')}</dd>
        </div>
        <div>
          <dt class="eyebrow">Education</dt>
          <dd class="mt-1">{education.map((e) => e.school).join(' · ')}</dd>
        </div>
        <div>
          <dt class="eyebrow">Elsewhere</dt>
          <dd class="mt-1 flex flex-wrap gap-x-4 gap-y-1">
            {site.social.map((s) => <a href={s.url} rel="me noopener" target="_blank" class="link-accent">{s.name}</a>)}
          </dd>
        </div>
      </dl>
      <a href="/resume" class="link-accent mt-5 inline-block text-sm">Full resume →</a>
    </aside>
  </section>
  <CtaBand />
</BaseLayout>
