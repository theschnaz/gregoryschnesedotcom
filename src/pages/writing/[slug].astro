---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/lib/format';
import { article } from '@/lib/schema';
import { site } from '@/site';
import profile from '@/assets/profile.jpg';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const url = new URL(`/writing/${entry.id}`, site.url).href;
const jsonLd = article({
  title: d.title,
  description: d.description,
  url,
  datePublished: d.pubDate,
  dateModified: d.updatedDate,
  image: new URL(`/og/writing/${entry.id}.png`, site.url).href,
});
---
<BaseLayout title={d.title} description={d.description} ogType="article" jsonLd={jsonLd}>
  <article>
    <header class="container-page pt-16 pb-10 sm:pt-24">
      <div class="mx-auto max-w-2xl">
        <a href="/writing" class="eyebrow hover:text-ink dark:hover:text-night-ink">← Writing</a>
        {d.series && <p class="mt-8 text-sm text-accent dark:text-night-accent">{d.series}{d.seriesPart && ` · Lesson ${d.seriesPart}`}</p>}
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{d.title}</h1>
        <p class="mt-5 text-lg text-pretty text-muted dark:text-night-muted">{d.description}</p>
        <div class="mt-8 flex items-center gap-3 text-sm">
          <Image src={profile} alt="" width={40} height={40} class="size-10 rounded-full" />
          <div>
            <p class="font-medium">{site.name}</p>
            <p class="text-muted dark:text-night-muted">
              <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time>
              {d.updatedDate && <> · Updated <time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate)}</time></>}
            </p>
          </div>
        </div>
      </div>
    </header>
    <div class="container-page">
      <div class="prose-gs mx-auto max-w-2xl">
        <Content />
      </div>
      <aside class="mx-auto mt-14 max-w-2xl rounded-2xl bg-accent-soft p-7 dark:bg-night-accent-soft">
        <p class="font-semibold">Questions, or a result to share?</p>
        <p class="mt-1 text-muted dark:text-night-muted">I read every email: <a href={`mailto:${site.email}`} class="link-accent">{site.email}</a>. For weekly writing, subscribe to <a href={site.newsletter.url} class="link-accent" target="_blank" rel="noopener">{site.newsletter.name}</a>.</p>
      </aside>
    </div>
  </article>
</BaseLayout>
