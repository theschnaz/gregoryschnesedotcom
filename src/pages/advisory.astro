---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { advisory, primaryCta, site } from '@/site';
const engagements = advisory.engagements;

---
<BaseLayout title="Advisory" description="Selective advisory from Gregory Schnese for B2B SaaS teams: paid-acquisition audits, measurement and attribution builds, and trial-to-paid conversion.">
  <PageHeader eyebrow="Advisory" title="Selective help for B2B SaaS demand engines." lede="I take on a small number of advisory engagements each quarter, alongside my full-time role. They are scoped, time-boxed and built around the systems behind the case studies on this site." />
  <section class="container-page grid gap-5 md:grid-cols-3">
    {engagements.map((e) => (
      <div class="card flex flex-col p-7" data-reveal>
        <h2 class="text-xl font-semibold tracking-tight">{e.title}</h2>
        <p class="mt-3 flex-1 text-pretty text-muted dark:text-night-muted">{e.body}</p>
        <p class="mt-6 border-t border-line pt-4 text-sm dark:border-night-line"><span class="eyebrow block mb-1">Best for</span>{e.fit}</p>
      </div>
    ))}
  </section>
  <section class="container-page mt-16 grid gap-10 md:grid-cols-2">
    <div>
      <h2 class="text-2xl font-semibold tracking-tight">Why me</h2>
      <ul class="mt-4 space-y-3 text-pretty">
        <li><a href="/work/fleetio" class="link-accent">10x inbound ARR</a> and 2x trial-to-paid at Fleetio, on a $4M+/yr paid budget.</li>
        <li><a href="/work/copromote" class="link-accent">4x members and SaaS revenue</a> at CoPromote, to 700K+ members.</li>
        <li>I can do the technical work myself, from tracking to <a href="/projects" class="link-accent">shipping React and React Native apps</a>.</li>
      </ul>
    </div>
    <div>
      <h2 class="text-2xl font-semibold tracking-tight">The best fit</h2>
      <ul class="mt-4 space-y-3 text-pretty text-muted dark:text-night-muted">
        {advisory.bestFit.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>
  <section class="container-page mt-16">
    <div class="rounded-3xl bg-accent-soft p-8 sm:p-12 dark:bg-night-accent-soft">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Start with a short conversation.</h2>
      <p class="mt-3 max-w-xl text-pretty text-muted dark:text-night-muted">Tell me what you’re working on. If I’m not the right fit, I’ll usually know someone who is.</p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a href={primaryCta.href} class="rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white dark:bg-night-accent dark:text-night" data-event="cta_click">{primaryCta.label}</a>
        <a href={`mailto:${site.email}?subject=Advisory`} class="link-accent text-sm">or email me</a>
      </div>
    </div>
  </section>
</BaseLayout>
