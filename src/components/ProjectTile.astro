---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
interface Props {
  entry: CollectionEntry<'projects'>;
  class?: string;
  large?: boolean;
}
const { entry, class: className, large = false } = Astro.props;
const d = entry.data;
---
<a
  href={`/projects/${entry.id}`}
  class:list={['card group relative flex flex-col overflow-hidden p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-ink/5 dark:hover:shadow-black/40', className]}
  data-reveal
>
  <div class="flex items-center justify-between gap-3">
    <StatusBadge status={d.status} />
    <span class="font-mono text-xs text-muted dark:text-night-muted">since {d.since}</span>
  </div>
  <h3 class:list={['mt-8 font-semibold tracking-tight', large ? 'text-3xl sm:text-4xl' : 'text-2xl']}>{d.title}</h3>
  <p class:list={['mt-3 text-pretty text-muted dark:text-night-muted', !large && 'flex-1', large && 'sm:text-lg max-w-md']}>{d.tagline}</p>
  {large && (
    <div class="mt-auto flex-1 pt-8">
      <p class="max-w-lg font-serif text-lg text-pretty italic">{d.description}</p>
      <p class="mt-6 text-sm font-medium">Read about {d.title} <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span></p>
    </div>
  )}
  <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Stack">
    {d.stack.map((s) => (
      <li class="rounded-md bg-paper px-2 py-1 font-mono text-[11px] text-muted dark:bg-night dark:text-night-muted">{s}</li>
    ))}
  </ul>
</a>
