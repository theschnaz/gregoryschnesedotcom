{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/yields-and-bounties", "destination": "/writing/yields-and-bounties", "permanent": true },
    { "source": "/metrics-in-metrics", "destination": "/writing/metrics-in-metrics", "permanent": true },
    { "source": "/how-to-run-a-proper-ab-test", "destination": "/writing/how-to-run-a-proper-ab-test", "permanent": true },
    { "source": "/work-with-me", "destination": "/advisory", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
